build/
dist/
*/dist/
.next/
out/
*.map
backend/prisma/seed.js*
backend/prisma/seed.d.ts*
backend/test-*
backend/start-debug.js

# Environment Variables & Secrets (NEVER PUSH)
.env
.env.*
*.env
**/.env
**/.env.*
!**/.env.example

